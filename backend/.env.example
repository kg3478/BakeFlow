# ============================================================
# BakeFlow ERP — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets!
# ============================================================

# ── App Identity ──────────────────────────────────────────────
BUSINESS_NAME=My Bakery
BUSINESS_PHONE=+91 XXXXX XXXXX

# ── CORS (optional — restrict API access to specific domains in production) ──
# Comma-separated list: https://yourdomain.com,https://www.yourdomain.com
# Leave unset to allow all origins (fine for development, OK for Render single-service)
# CORS_ORIGIN=https://yourdomain.com

# ── PostgreSQL / Neon Database ────────────────────────────────
# Get your connection string from https://console.neon.tech
# It looks like: postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST.neon.tech/neondb?sslmode=require

# ── Google Sign-In (OAuth) ────────────────────────────────────
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# Authorized origins: your Render URL (e.g. https://bakeflow.onrender.com)
# Authorized redirect URIs: same URL
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ── JWT Authentication ────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-long-random-secret-here-change-this
JWT_EXPIRY=7d

# ── Admin / Owner Password ────────────────────────────────────
# This is the password owners enter alongside Google Sign-In to log in.
# For platform admin access, this is the password to the /admin console.
ADMIN_PASSWORD=change-me-in-production

# ── Platform Admin ────────────────────────────────────────────
# The Google email address that gets full platform admin access at /admin
PLATFORM_ADMIN_EMAIL=your_admin_google_email@gmail.com

# ── Gemini AI (raw material invoice scanning) ─────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Twilio WhatsApp (customer invoice delivery + OTP) ─────────
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Twilio Sandbox sender (for testing): whatsapp:+14155238886
# For production, use your approved Twilio sender number
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
